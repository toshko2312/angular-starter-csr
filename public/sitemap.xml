<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keep in step with the public routes in src/app/app.routes.ts and
  prerender-routes.txt. Each URL lists every language version of itself,
  including itself, which is what Google requires of hreflang annotations.

  Host: www.centralfoodcatering.com only. The apex 308-redirects to www, so
  every <loc> and every hreflang href must use www — pointing them at the
  apex makes Google treat these entries as redirect targets, not canonical
  URLs, and a redirecting hreflang target gets the whole annotation ignored.

  priority/changefreq are intentionally omitted: Google has ignored both
  since at least 2020, and they were never anything more than a weak, easily
  stale hint elsewhere. Not worth hand-maintaining for six URLs.

  lastmod is the date of the most recent commit that changed each page's
  visible content (its template plus public/i18n/bg.json and en.json, which
  drive both language versions from the same strings), not a build/deploy
  timestamp or a fixed placeholder. Regenerate from git history when content
  changes, from the last commit touching each page's template and i18n files.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://www.centralfoodcatering.com/</loc>
    <lastmod>2026-09-05</lastmod>
    <xhtml:link rel="alternate" hreflang="bg" href="https://www.centralfoodcatering.com/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://www.centralfoodcatering.com/en" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.centralfoodcatering.com/" />
  </url>
  <url>
    <loc>https://www.centralfoodcatering.com/menu</loc>
    <lastmod>2026-09-05</lastmod>
