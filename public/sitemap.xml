    <xhtml:link rel="alternate" hreflang="en" href="https://www.centralfoodcatering.com/en/menu" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.centralfoodcatering.com/menu" />
  </url>
  <url>
    <loc>https://www.centralfoodcatering.com/contacts</loc>
