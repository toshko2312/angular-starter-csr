# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. All of these are inlined into the browser bundle
# by set-env.js, so they are PUBLIC. Only publishable values belong here —
# never a Supabase service_role key or the admin password.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key (browser-safe, gated by RLS)
SUPABASE_ANON_KEY=

# Email of the admin auth user. The /admin form takes the username "admin"
# and signs in with this address. An address is not a secret; the PASSWORD is
# set in Supabase (Authentication -> Users) and never appears in the bundle.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# SERVER-ONLY -- unlike everything above, these are NOT read by set-env.js and
# never reach the browser bundle. They live as Supabase Edge Function secrets
# (used by supabase/functions/notify-enquiry):
#
#   npx supabase secrets set RESEND_API_KEY=... ADMIN_EMAIL=...
#
# The .env copy exists so `supabase functions serve --env-file .env` works
# locally. A Resend key in the bundle would be readable by every visitor.
# ---------------------------------------------------------------------------

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender address; needs a domain verified in Resend. Left blank the
# function uses onboarding@resend.dev, which ONLY delivers to the address that
# owns the Resend account.
# Production: RESEND_FROM="Central Catering <noreply@centralfoodcatering.com>"
RESEND_FROM=

# Optional. Public site origin used for the admin deep link in the notification
# email. Left blank the function uses https://www.centralfoodcatering.com; set it
# only to point a build at another origin.
SITE_URL=
