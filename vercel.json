{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/index.csr"
    },
    {
      "source": "/admin",
      "destination": "/index.csr"
    },
    {
      "source": "/en/admin/:path*",
      "destination": "/index.csr"
    },
    {
      "source": "/en/admin",
      "destination": "/index.csr"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|webp|png|jpg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
