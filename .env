# ---------------------------------------------------------------------------
# Environment template. Copy to `.env` and fill in the values.
#
#   cp .env.example .env
#
# These values are inlined into the browser bundle by `set-env.js`, so they are
# PUBLIC. Only put publishable/anon keys here — never a Supabase service_role
# key, a database password, or any other server-side secret.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://iyztahopwvhjyasaoqeg.supabase.co

# Supabase anon / publishable key (safe for the browser, RLS-protected)
# Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml5enRhaG9wd3Zoanlhc2FvcWVnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTc5NTgyNDgsImV4cCI6MjA3MzUzNDI0OH0.75oDMtZ4hhg6hprNy2sGVood24Fnsm06uaSN7Sk6p7I
